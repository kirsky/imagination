includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - imagination.php
        - includes
    excludePaths:
        # Third-party code prefixed by Strauss; committed but not ours to analyse.
        - vendor-prefixed
    # Keep in sync with "Requires PHP" in imagination.php.
    phpVersion: 70400
    bootstrapFiles:
        - phpstan-bootstrap.php
