{
    "name": "indigit/imagination",
    "description": "Runs WordPress image processing through libvips, a fast multi-threaded image library",
    "type": "wordpress-plugin",
    "version": "1.0.0",
    "license": "GPL-2.0-or-later",
    "homepage": "https://indigit.info/imagination/",
    "authors": [
        {
            "name": "Kirill S.",
            "email": "kirill@indigit.info",
            "homepage": "https://indigit.info/"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Indigit\\Imagination\\": "includes/"
        },
        "classmap": [
            "vendor-prefixed/"
        ],
        "files": [
            "includes/functions.php"
        ]
    },
    "require": {
        "php": ">=7.4",
        "ext-ffi": "*",
        "jcupitt/vips": "2.6.1",
        "composer/installers": "2.3.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
        "phpcompatibility/phpcompatibility-wp": "2.1.8",
        "squizlabs/php_codesniffer": "3.13.6",
        "wp-coding-standards/wpcs": "3.4.1",
        "slevomat/coding-standard": "8.22.1",
        "phpstan/phpstan": "2.2.16",
        "szepeviktor/phpstan-wordpress": "2.0.4"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4.0"
        }
    },
    "extra": {
        "strauss": {
            "namespace_prefix": "Indigit\\Imagination\\Vendor\\",
            "classmap_prefix": "Indigit_Imagination_Vendor_",
            "packages": [
                "jcupitt/vips"
            ],
            "exclude_from_copy": {
                "file_patterns": [
                    "/Psr\\/Log\\/Test\\//"
                ]
            },
            "classmap_output": false,
            "delete_vendor_packages": true,
            "include_modified_date": false
        }
    },
    "scripts": {
        "lint:php": "phpcs --standard=phpcs.xml",
        "lint:php:fix": "phpcbf --standard=phpcs.xml",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "strauss:fetch": [
            "sh -c 'test -f bin/strauss.phar || { mkdir -p bin && curl -fsSL -o bin/strauss.phar https://github.com/BrianHenryIE/strauss/releases/download/0.30.0/strauss.phar; }'",
            "sh -c 'printf \"%s  %s\\n\" 08c1a8e553594745c22294e158129005fd11ed09ed452d7d4f48566f38c66c96 bin/strauss.phar | sha256sum -c --quiet - || { rm -f bin/strauss.phar; echo \"strauss.phar checksum mismatch; removed\" >&2; exit 1; }'"
        ],
        "prefix-namespaces": [
            "@strauss:fetch",
            "@php bin/strauss.phar",
            "@composer dump-autoload"
        ],
        "pre-autoload-dump": [
            "mkdir -p vendor-prefixed"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ]
    }
}
